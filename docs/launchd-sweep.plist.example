<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentslots.sweep.REPLACE_WITH_WORKTREE_NAME</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PROJECT/PATH/scripts/agent-slots</string>
    <string>sweep</string>
    <string>--yes</string>
    <string>--repo</string>
    <string>/ABSOLUTE/SHARED/REPOSITORY/PATH</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
</dict>
</plist>
